{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "ApiKey": ""
  },
  "Network": {
    "AllowPrivateAddresses": false,
    "MaxPingCount": 10,
    "MaxTimeoutMs": 10000
  },
  "HolidayApi": { "BaseUrl": "https://date.nager.at/api/v3/" },
  "PublicIpApi": { "BaseUrl": "https://api.ipify.org/" },
  "Cors": { "AllowedOrigins": [ "http://localhost:3000" ] },
  "Swagger": { "Enabled": false }
}
