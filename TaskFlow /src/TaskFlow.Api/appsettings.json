{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=taskflow.db"
  },
  "Jwt": {
    "Issuer": "TaskFlow",
    "Audience": "TaskFlow.Clients",
    "Key": "CHANGE_ME_USE_ENV_VAR_AT_LEAST_32_CHARACTERS",
    "ExpiryMinutes": 60
  },
  "HolidayApi": {
    "BaseUrl": "https://date.nager.at/api/v3/"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Swagger": {
    "Enabled": false
  }
}
